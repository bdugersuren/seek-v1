erDiagram

  %% =========================================================================
  %% 1. AUTH SERVICE DATABASE (auth_db)
  %% =========================================================================
  AUTH_USER_ACCOUNT ||--o{ AUTH_REFRESH_SESSION : maintains
  AUTH_USER_ACCOUNT {
    uuid id PK
    varchar email UK
    varchar password_hash
    varchar status "active | suspended | unverified"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  AUTH_REFRESH_SESSION {
    uuid id PK
    uuid user_id FK
    varchar token UK
    timestamp expires_at
    timestamp created_at
    timestamp updated_at
  }

  %% =========================================================================
  %% 2. PROFILE SERVICE DATABASE (profile_db)
  %% =========================================================================
  PROFILE_PERSON ||--o{ PROFILE_ROLE : has
  PROFILE_PERSON ||--o{ PROFILE_EMPLOYMENT_PLACEMENT : holds
  PROFILE_PERSON ||--o{ PROFILE_ACADEMIC_PLACEMENT : holds
  PROFILE_PERSON {
    uuid id PK
    uuid user_id "logical reference to auth_db.AUTH_USER_ACCOUNT"
    varchar first_name
    varchar last_name
    varchar display_name
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  PROFILE_ROLE {
    uuid id PK
    uuid person_id FK
    varchar role_name "admin | candidate | organisation_admin | assessor"
    timestamp valid_from
    timestamp valid_to
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }
  PROFILE_EMPLOYMENT_PLACEMENT {
    uuid id PK
    uuid person_id FK
    uuid organisation_id "logical reference to organisation_db.ORG_ORGANISATION"
    varchar job_title
    varchar department
    timestamp valid_from
    timestamp valid_to
    boolean is_active
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }
  PROFILE_ACADEMIC_PLACEMENT {
    uuid id PK
    uuid person_id FK
    varchar institution_name
    varchar degree
    varchar major
    timestamp valid_from
    timestamp valid_to
    boolean is_active
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }

  %% =========================================================================
  %% 3. ORGANISATION SERVICE DATABASE (organisation_db)
  %% =========================================================================
  ORG_ORGANISATION ||--o{ ORG_UNIT : contains
  ORG_ORGANISATION ||--o{ ORG_MEMBERSHIP : employs
  ORG_UNIT ||--o{ ORG_MEMBERSHIP : assigns
  ORG_ORGANISATION {
    uuid id PK
    varchar name
    varchar code UK
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  ORG_UNIT {
    uuid id PK
    uuid organisation_id FK
    uuid parent_unit_id FK "self-reference for hierarchy"
    varchar name
    varchar code UK
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }
  ORG_MEMBERSHIP {
    uuid id PK
    uuid organisation_id FK
    uuid unit_id FK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    varchar role "admin | manager | member"
    varchar status "active | pending | inactive"
    timestamp created_at
    timestamp updated_at
  }

  %% =========================================================================
  %% 4. VERIFICATION SERVICE DATABASE (verification_db)
  %% =========================================================================
  VERIFICATION_REQUEST ||--o| VERIFICATION_RECORD : creates
  VERIFICATION_POLICY ||--o{ VERIFICATION_RECORD : enforces
  VERIFICATION_REQUEST {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid verifier_id "logical reference to profile_db.PROFILE_PERSON (actor)"
    varchar target_type "employment | academic | identity"
    uuid target_id "id from respective placement tables"
    varchar status "pending | approved | rejected"
    timestamp created_at
    timestamp updated_at
  }
  VERIFICATION_RECORD {
    uuid id PK
    uuid request_id FK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid policy_id FK
    timestamp verified_at
    timestamp expires_at
    timestamp revoked_at
    varchar status "valid | expired | revoked"
    timestamp created_at
    timestamp updated_at
  }
  VERIFICATION_POLICY {
    uuid id PK
    varchar name
    jsonb rule_config
    varchar status "active | retired"
    timestamp created_at
    timestamp updated_at
  }

  %% =========================================================================
  %% 5. COMPETENCY SERVICE DATABASE (competency_db)
  %% =========================================================================
  COMP_FRAMEWORK ||--o{ COMP_LEVEL : defines
  COMP_LEVEL ||--o{ COMP_TARGET : defines
  COMP_TARGET ||--o{ COMP_RECORD : measured_by
  COMP_FRAMEWORK {
    uuid id PK
    varchar name
    text description
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }
  COMP_LEVEL {
    uuid id PK
    uuid framework_id FK
    varchar name
    integer level_number
    text description
  }
  COMP_TARGET {
    uuid id PK
    uuid level_id FK
    varchar name
    text description
  }
  COMP_RECORD {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid target_id FK
    timestamp acquired_at
    numeric score
    uuid proven_by_attempt_id "logical reference to execution_db.EXEC_ATTEMPT"
    varchar status "verified | self_declared"
    timestamp created_at
    timestamp updated_at
  }

  %% =========================================================================
  %% 6. ASSESSMENT SERVICE DATABASE (assessment_db)
  %% =========================================================================
  ASM_DEFINITION ||--o{ ASM_VERSION : versions
  ASM_VERSION ||--o{ ASM_SECTION : organises
  ASM_SECTION ||--o{ ASM_QUESTION : contains
  ASM_QUESTION ||--o{ ASM_QUESTION_OPTION : has
  ASM_DEFINITION {
    uuid id PK
    varchar title
    text description
    varchar category
    varchar status "active | draft | archived"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  ASM_VERSION {
    uuid id PK
    uuid definition_id FK
    varchar version_code
    varchar status "published | draft | retired"
    integer duration_seconds
    jsonb proctoring_policy "ASM_PROCTORING_POLICY contract"
    jsonb result_visibility_policy "ASM_RESULT_VISIBILITY_POLICY contract"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  ASM_SECTION {
    uuid id PK
    uuid version_id FK
    varchar name
    integer order
    timestamp created_at
    timestamp updated_at
  }
  ASM_QUESTION {
    uuid id PK
    uuid section_id FK
    varchar code
    varchar type "single_choice | multiple_choice | fill_blank | essay | etc"
    text prompt
    text instruction
    numeric points
    boolean required
    integer order
    jsonb media_urls
    timestamp created_at
    timestamp updated_at
  }
  ASM_QUESTION_OPTION {
    uuid id PK
    uuid question_id FK
    varchar option_code
    text label
    integer order
    boolean is_correct "hidden from client"
  }

  %% =========================================================================
  %% 7. COMMERCE SERVICE DATABASE (commerce_db)
  %% =========================================================================
  COMM_OFFER ||--o{ COMM_ORDER : priced_for
  COMM_ORDER ||--o{ COMM_PAYMENT : pays_for
  COMM_ORDER ||--o{ COMM_ENTITLEMENT : grants
  COMM_OFFER {
    uuid id PK
    uuid assessment_version_id "logical reference to assessment_db.ASM_VERSION"
    numeric price
    varchar currency
    varchar access_mode "public | private_code | assigned_users"
    timestamp valid_from
    timestamp valid_to
    varchar status "active | inactive"
    timestamp created_at
    timestamp updated_at
  }
  COMM_ORDER {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid offer_id FK
    uuid coupon_id "logical reference to COMM_COUPON"
    numeric amount
    varchar status "pending | paid | cancelled | refunded"
    timestamp created_at
    timestamp updated_at
  }
  COMM_PAYMENT {
    uuid id PK
    uuid order_id FK
    varchar payment_method
    varchar transaction_id UK
    varchar status "completed | failed | processing"
    timestamp paid_at
    timestamp created_at
  }
  COMM_COUPON {
    uuid id PK
    varchar code UK
    varchar discount_type "percentage | fixed"
    numeric discount_value
    varchar status "active | expired | retired"
    timestamp valid_from
    timestamp valid_to
  }
  COMM_ENTITLEMENT {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid offer_id FK
    uuid order_id FK
    varchar status "active | consumed | expired | revoked"
    timestamp granted_at
    timestamp expires_at
  }

  %% =========================================================================
  %% 8. EXECUTION SERVICE DATABASE (execution_db) - Quiz Runtime (20,000+ scaling)
  %% =========================================================================
  EXEC_ATTEMPT ||--o| EXEC_ENCRYPTED_PAYLOAD : encrypted_by
  EXEC_ATTEMPT ||--o| EXEC_ATTEMPT_STATE_SNAPSHOT : persists
  EXEC_ATTEMPT ||--o{ EXEC_HEARTBEAT : tracks
  EXEC_ATTEMPT ||--o{ EXEC_VIOLATION : records
  EXEC_ATTEMPT {
    uuid id PK "attemptId"
    uuid entitlement_id "logical reference to commerce_db.COMM_ENTITLEMENT"
    uuid assessment_version_id "logical reference to assessment_db.ASM_VERSION"
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    varchar status "waiting | preloaded | active | autosaving | submitted | expired | locked"
    timestamp starts_at
    timestamp ends_at
    integer duration_seconds
    timestamp created_at
    timestamp updated_at
    integer version
  }
  EXEC_ENCRYPTED_PAYLOAD {
    uuid id PK
    uuid attempt_id FK
    uuid quiz_id "logical reference to assessment_db.ASM_VERSION"
    varchar algorithm "AES-GCM"
    varchar key_delivery "start_unlock_event"
    text encrypted_content
    varchar iv
    varchar checksum
    timestamp created_at
  }
  EXEC_ATTEMPT_STATE_SNAPSHOT {
    uuid attempt_id PK "logical FK reference to EXEC_ATTEMPT"
    jsonb answers "Record of questionId to AssessmentAnswerValue"
    jsonb marked_for_review "Record of questionId to boolean"
    varchar current_question_id
    integer local_version
    integer server_version
    timestamp last_saved_at
    boolean pending_submit
    timestamp updated_at
  }
  EXEC_HEARTBEAT {
    uuid id PK
    uuid attempt_id FK
    timestamp client_now
    timestamp server_now
    integer local_version
    boolean visible
    boolean fullscreen
    timestamp created_at
  }
  EXEC_VIOLATION {
    uuid id PK
    uuid attempt_id FK
    varchar type "fullscreen_exit | visibility_hidden | window_blur | copy_attempt | paste_attempt | context_menu | network_loss | device_change"
    timestamp occurred_at
    integer count
    text message
    timestamp created_at
  }

  %% =========================================================================
  %% 9. EVALUATION SERVICE DATABASE (evaluation_db)
  %% =========================================================================
  EVAL_SUBMISSION ||--o| EVAL_RESULT : scores
  EVAL_SUBMISSION ||--o{ EVAL_JOB : runs
  EVAL_SUBMISSION {
    uuid id PK
    uuid attempt_id "logical reference to execution_db.EXEC_ATTEMPT"
    varchar receipt_id UK
    timestamp submitted_at
    varchar reason "user_submit | timer_expired | offline_expired | policy_lock"
    jsonb answers_payload "final state answers snapshot"
    varchar status "accepted | processing | evaluated | failed"
    timestamp created_at
    timestamp updated_at
  }
  EVAL_RESULT {
    uuid id PK
    uuid submission_id FK 
    numeric score
    integer total_questions
    integer answered_count
    integer correct_count
    jsonb breakdown "section and competency level breakdown scores"
    varchar status "draft | final"
    timestamp created_at
    timestamp updated_at
    integer version
  }
  EVAL_JOB {
    uuid id PK
    uuid submission_id FK
    varchar status "queued | processing | completed | failed"
    integer attempts
    text error_log
    timestamp created_at
  }

  %% =========================================================================
  %% 10. LEARNING SERVICE DATABASE (learning_db)
  %% =========================================================================
  LEARN_PATH ||--o{ LEARN_PROGRESS : contains
  LEARN_RECOMMENDATION {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    uuid assessment_result_id "logical reference to evaluation_db.EVAL_RESULT"
    uuid gap_competency_id "logical reference to competency_db.COMP_TARGET"
    uuid suggested_course_id
    timestamp created_at
  }
  LEARN_PATH {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    varchar title
    varchar status "active | completed | inactive"
    timestamp created_at
  }
  LEARN_PROGRESS {
    uuid id PK
    uuid path_id FK
    uuid course_id
    numeric completion_percentage
    timestamp updated_at
  }

  %% =========================================================================
  %% 11. AI SERVICE DATABASE (ai_db)
  %% =========================================================================
  AI_PROMPT_REGISTRY ||--o{ AI_INVOCATION_LOG : templates
  AI_INVOCATION_LOG {
    uuid id PK
    uuid correlation_id
    varchar provider "ollama | external"
    varchar model_name
    text prompt
    text response
    integer tokens_used
    integer duration_ms
    timestamp created_at
  }
  AI_PROMPT_REGISTRY {
    uuid id PK
    varchar name UK
    text template
    integer version
    varchar status "active | retired"
  }

  %% =========================================================================
  %% 12. INTEGRATION SERVICE DATABASE (integration_db)
  %% =========================================================================
  INTEGRATION_ADAPTER {
    uuid id PK
    varchar type "dmoj | ctfd | nextcloud | payment_gateway"
    jsonb config "endpoint and credentials mapping"
    varchar status "active | inactive"
  }
  INT_DMOJ_SUBMISSION_MAP {
    uuid id PK
    uuid attempt_id "logical reference to execution_db.EXEC_ATTEMPT"
    varchar dmoj_submission_id UK
    varchar status "pending | graded"
    numeric score
  }
  INT_PAYMENT_TX {
    uuid id PK
    uuid order_id "logical reference to commerce_db.COMM_ORDER"
    varchar provider "khanbank | golomt | qpay"
    jsonb raw_response
    varchar status "success | pending | failed"
  }

  %% =========================================================================
  %% 13. FILE SERVICE DATABASE (file_db)
  %% =========================================================================
  FILE_METADATA {
    uuid id PK
    uuid owner_id "logical reference to PROFILE_PERSON or ORG_ORGANISATION"
    varchar bucket_name
    varchar file_key UK
    varchar file_name
    bigint file_size
    varchar checksum "sha256"
    varchar content_type
    varchar status "uploaded | temporary | deleted"
    timestamp created_at
  }

  %% =========================================================================
  %% 14. REPORTING SERVICE DATABASE (reporting_db) - Read Only Analytical Models
  %% =========================================================================
  RPT_VERIFIED_REPORT {
    uuid id PK
    uuid person_id "logical reference to profile_db.PROFILE_PERSON"
    integer verified_count
    timestamp last_verified_at
    jsonb comparison_data
    timestamp updated_at
  }
  RPT_DASHBOARD {
    uuid id PK
    varchar name
    jsonb config
  }

  %% =========================================================================
  %% 15. PLATFORM SERVICE DATABASE (platform_db)
  %% =========================================================================
  PLAT_NOTIFICATION {
    uuid id PK
    uuid recipient_id "logical reference to auth_db.AUTH_USER_ACCOUNT"
    varchar type "email | sms | push"
    varchar title
    text content
    varchar status "pending | sent | failed"
    timestamp created_at
  }
  PLAT_AUDIT_LOG {
    uuid id PK
    uuid actor_id "logical reference to profile_db.PROFILE_PERSON"
    varchar action "create | update | delete | access"
    varchar domain
    uuid entity_id
    jsonb old_value
    jsonb new_value
    timestamp created_at
  }
  PLAT_SCHEDULER_JOB {
    uuid id PK
    varchar job_name UK
    varchar cron_expression
    timestamp next_run_at
    varchar status "scheduled | running | paused"
  }

  %% =========================================================================
  %% =========================================================================
  %% CROSS-DATABASE LOGICAL RELATIONSHIPS OMITTED FOR MAXIMUM COMPATIBILITY
  %% Logical references remain documented in entity field comments.
  %% =========================================================================