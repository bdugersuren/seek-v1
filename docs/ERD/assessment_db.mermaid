erDiagram
    %% ==========================================
    %% QUESTION VERSIONING
    %% ==========================================

    Question ||--|{ QuestionVersion : "has versions"
    QuestionVersion ||--o{ QuestionOptionVersion : "has options"

    Question {
        String id PK
        String code UK
        String publishedVersionId FK
        String lifecycleStatus
        String ownerOrganizationId
        String createdBy
        DateTime createdAt
        DateTime updatedAt
        DateTime archivedAt
    }

    QuestionVersion {
        String id PK
        String questionId FK
        Int versionNumber
        String versionStatus
        String typeId FK
        String title
        Text body
        Int defaultTime
        Decimal defaultMaxScore
        Decimal defaultMinScore
        Jsonb payload
        Jsonb answerConfig
        Jsonb presentationConfig
        String changeSummary
        String createdBy
        DateTime createdAt
        String reviewedBy
        DateTime reviewedAt
        String publishedBy
        DateTime publishedAt
        DateTime retiredAt
    }

    QuestionOptionVersion {
        String id PK
        String questionVersionId FK
        String optionKey
        String value
        Int orderIndex
        Jsonb matchRules
        Jsonb metadata
    }

    %% ==========================================
    %% TARGET AUDIENCE
    %% ==========================================

    AudienceType ||--o{ AudienceLevel : "has levels"
    AudienceType ||--o{ AssessmentContext : "used by"
    AudienceLevel ||--o{ AssessmentContext : "targets"

    AudienceType {
        String id PK
        String code UK
        String name
        String description
        Boolean isActive
    }

    AudienceLevel {
        String id PK
        String audienceTypeId FK
        String parentId FK
        String code
        String name
        Int orderIndex
        Boolean isActive
    }

    AssessmentContext {
        String id PK
        String code UK
        String name
        String audienceTypeId FK
        String audienceLevelId FK
        String curriculumId FK
        String subjectId FK
        String occupationId FK
        String organizationTypeId FK
        String difficultyScaleId FK
        String cognitiveFrameworkId FK
        String competenceFrameworkId FK
        DateTime validFrom
        DateTime validTo
        Boolean isActive
    }

    %% ==========================================
    %% TOPIC
    %% ==========================================

    Topic ||--o{ Topic : "parent / children"
    Topic ||--o{ TopicQuestionClassification : "classifies questions"

    Topic {
        String id PK
        String parentId FK
        String code UK
        String title
        String description
        Boolean isActive
        DateTime createdAt
        DateTime updatedAt
    }

    %% ==========================================
    %% DIFFICULTY SCALE
    %% ==========================================

    DifficultyScale ||--o{ DifficultyLevel : "has levels"
    DifficultyScale ||--o{ AssessmentContext : "used by"
    DifficultyLevel ||--o{ TopicQuestionClassification : "difficulty"

    DifficultyScale {
        String id PK
        String code UK
        String name
        String description
        Boolean isActive
    }

    DifficultyLevel {
        String id PK
        String difficultyScaleId FK
        String code
        String name
        Int rank
        String description
        Boolean isActive
    }

    %% ==========================================
    %% COGNITIVE FRAMEWORK
    %% ==========================================

    CognitiveFramework ||--o{ CognitiveLevel : "has levels"
    CognitiveFramework ||--o{ AssessmentContext : "used by"
    CognitiveLevel ||--o{ TopicQuestionClassification : "cognitive demand"

    CognitiveFramework {
        String id PK
        String code UK
        String name
        String description
        Boolean isActive
    }

    CognitiveLevel {
        String id PK
        String cognitiveFrameworkId FK
        String code
        String name
        Int rank
        String description
        Boolean isActive
    }

    %% ==========================================
    %% COMPETENCE FRAMEWORK
    %% ==========================================

    CompetenceFramework ||--o{ CompetenceType : "has competences"
    CompetenceFramework ||--o{ AssessmentContext : "used by"
    CompetenceType ||--o{ TopicQuestionCompetence : "measured by"

    CompetenceFramework {
        String id PK
        String code UK
        String name
        String version
        String description
        DateTime validFrom
        DateTime validTo
        Boolean isActive
    }

    CompetenceType {
        String id PK
        String competenceFrameworkId FK
        String parentId FK
        String code
        String name
        String description
        Int orderIndex
        Boolean isActive
    }

    %% ==========================================
    %% QUESTION CLASSIFICATION BY CONTEXT
    %% ==========================================

    Question ||--o{ TopicQuestionClassification : "classified"
    AssessmentContext ||--o{ TopicQuestionClassification : "classification context"
    QuestionVersion ||--o{ TopicQuestionClassification : "validated against"

    TopicQuestionClassification ||--o{ TopicQuestionCompetence : "competences"

    TopicQuestionClassification {
        String id PK
        String topicId FK
        String questionId FK
        String assessmentContextId FK
        String difficultyLevelId FK
        String cognitiveLevelId FK
        String validatedQuestionVersionId FK
        String classificationStatus
        Boolean isPrimary
        Decimal weight
        DateTime validFrom
        DateTime validTo
        String createdBy
        DateTime createdAt
        String reviewedBy
        DateTime reviewedAt
    }

    TopicQuestionCompetence {
        String id PK
        String classificationId FK
        String competenceId FK
        Decimal weight
        Boolean isPrimary
        DateTime createdAt
    }

    %% ==========================================
    %% QUIZ TEMPLATE
    %% ==========================================

    QuizTemplate ||--o{ QuizSection : "has sections"
    QuizSection ||--o{ SectionQuestion : "has questions"
    Question ||--o{ SectionQuestion : "logical question"
    QuestionVersion ||--o{ SectionQuestion : "optional pinned version"
    AssessmentContext ||--o{ QuizTemplate : "target context"

    QuizTemplate {
        String id PK
        String assessmentContextId FK
        String name
        String description
        Int duration
        Decimal passingScore
        Boolean shuffleQuestions
        Boolean shuffleOptions
        String status
        DateTime createdAt
        DateTime updatedAt
    }

    QuizSection {
        String id PK
        String templateId FK
        String title
        String description
        Int orderIndex
        Int questionCount
        String topicId FK
        String difficultyLevelId FK
        Decimal maxScorePerQuestion
        Decimal minScorePerQuestion
        String selectionStrategy
        Boolean shuffleOptions
        DateTime createdAt
        DateTime updatedAt
    }

    SectionQuestion {
        String id PK
        String sectionId FK
        String questionId FK
        String pinnedQuestionVersionId FK
        String versionSelectionMode
        Int orderIndex
        Decimal maxScoreOverride
        Decimal minScoreOverride
        Boolean isRequired
        DateTime createdAt
    }