# root .env.example template for all profiles
NODE_ENV=development

POSTGRES_USER=seek_admin
POSTGRES_PASSWORD=seek_postgres_pass
POSTGRES_DB=seek_core_db
DATABASE_URL=postgresql://seek_admin:seek_postgres_pass@auth-postgres:5432/auth_db

# Security defaults
AUTH_JWT_SECRET=seek_jwt_secret_key_placeholder_safe_entropy_1234567890
AUTH_TOKEN_ISSUER=seek.mn
AUTH_TOKEN_AUDIENCE=seek.mn

AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
AUTH_CSRF_ALLOW_MISSING_ORIGIN=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_PUBLIC_APP_URL=http://localhost:3001
AUTH_EMAIL_FROM=no-reply@seek.mn
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_DELIVERY_MODE=log

# Optional SMTP email delivery. Set AUTH_EMAIL_DELIVERY_MODE=smtp to send in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HELO_DOMAIN=seek.mn

# Local test account credentials
AUTH_TEST_EMAIL=tester@seek.local
AUTH_TEST_PASSWORD=TestPassword123!
AUTH_SUPERADMIN_EMAIL=superadmin@lms.local
AUTH_SUPERADMIN_PASSWORD=TestPassword123!
