FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.5.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/assessment-web/package.json apps/assessment-web/
COPY apps/portal-web/package.json apps/portal-web/
COPY packages/auth-client/package.json packages/auth-client/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/observability/package.json packages/observability/
COPY packages/testing/package.json packages/testing/
COPY packages/ui/package.json packages/ui/
COPY services/ai/package.json services/ai/
COPY services/assessment/package.json services/assessment/
COPY services/auth/package.json services/auth/
COPY services/commerce/package.json services/commerce/
COPY services/competency/package.json services/competency/
COPY services/evaluation/package.json services/evaluation/
COPY services/execution/package.json services/execution/
COPY services/file/package.json services/file/
COPY services/gateway/package.json services/gateway/
COPY services/integration/package.json services/integration/
COPY services/learning/package.json services/learning/
COPY services/notification/package.json services/notification/
COPY services/organisation/package.json services/organisation/
COPY services/platform/package.json services/platform/
COPY services/profile/package.json services/profile/
COPY services/reporting/package.json services/reporting/
COPY services/verification/package.json services/verification/
RUN pnpm install --frozen-lockfile
