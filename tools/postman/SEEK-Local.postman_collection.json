{
  "info": {
    "name": "SEEK-Local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/health",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status is successful', () => pm.response.to.have.status(201));",
                  "pm.test('AccessToken exists', () => pm.expect(response.accessToken).to.exist);",
                  "pm.test('No password hash in response', () => pm.expect(response.user.password).to.be.undefined);",
                  "pm.environment.set('accessToken', response.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/login",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status is successful', () => pm.response.to.have.status(200));",
                  "pm.test('Email matches', () => pm.expect(response.email).to.eql(pm.environment.get('testEmail')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/me",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status is successful', () => pm.response.to.have.status(201));",
                  "pm.test('New access token exists', () => pm.expect(response.accessToken).to.exist);",
                  "pm.test('Token rotates', () => pm.expect(response.accessToken).to.not.eql(pm.environment.get('accessToken')));",
                  "pm.environment.set('accessToken', response.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/refresh",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is successful', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/logout",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "Missing Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/me",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Invalid Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid-token-value"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/me",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Spoofed Identity Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway strips spoofed headers and request fails 401 without valid JWT', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "spoofed-user-id"
              },
              {
                "key": "x-session-id",
                "value": "spoofed-session-id"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/me",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Disallowed Origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Disallowed Origin returns 403 Forbidden', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://malicious-site.com"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/logout",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
