    "rxjs": "^7.8.1",
    "@prisma/client": "^5.10.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2"
  }
